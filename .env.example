# Copy to .env and adjust. Every setting has a safe default (src/musicpods/config.py).
# Read by the Makefile. Keep comments on their own lines. Never commit .env.

# ---------------------------------------------------------------- storage
# Bronze, Iceberg warehouse, DuckDB file and ops state live here (git-ignored).
MUSICPODS_DATA_DIR=./data
# Salt for user pseudonyms. Default: a random salt generated once into $MUSICPODS_DATA_DIR/ops.
# MUSICPODS_PSEUDONYM_SALT=

# ---------------------------------------------------------------- HTTP etiquette
# MusicBrainz asks for a descriptive User-Agent with contact information.
# MUSICPODS_HTTP_USER_AGENT=spotify-music-podcasts-aws/0.1 (+https://github.com/rohit91jacob/spotify-music-podcasts-aws)
MUSICPODS_HTTP_TIMEOUT_SECONDS=60
MUSICPODS_HTTP_RETRIES=4
# MusicBrainz allows one request per second; never set this below 1.
MUSICPODS_MB_MIN_INTERVAL_SECONDS=1.1

# ---------------------------------------------------------------- ListenBrainz panel
MUSICPODS_LB_SEED_ARTISTS=30
MUSICPODS_LB_USERS=40
MUSICPODS_LB_WINDOW_DAYS=28
MUSICPODS_LB_MAX_LISTENS_PER_USER=4000
# Users above this many listens on any day of the week are treated as bots and skipped.
MUSICPODS_LB_MAX_DAILY_LISTENS=480
MUSICPODS_LB_FRESH_RELEASE_DAYS=30

# ---------------------------------------------------------------- MusicBrainz lookups
MUSICPODS_MB_MAX_ARTISTS=600
MUSICPODS_MB_MAX_RECORDINGS=3000
MUSICPODS_MB_MAX_RELEASE_GROUPS=2000
# Release groups of the most-played fresh releases, looked up for the release-date check.
MUSICPODS_MB_FRESH_RELEASE_GROUPS=200
MUSICPODS_MB_REFRESH_DAYS=30

# ---------------------------------------------------------------- Apple Podcasts charts + RSS
MUSICPODS_CHART_COUNTRIES=us,gb,ca,au,in,ie,de,fr,br,jp
MUSICPODS_CHART_SIZE=100
MUSICPODS_RSS_TOP_N_PER_COUNTRY=10
MUSICPODS_RSS_MAX_FEEDS=60

# ---------------------------------------------------------------- optional, key-gated sources
# Each source is skipped (not failed) when its credentials are empty.
LASTFM_API_KEY=
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------- emulated AWS
# Default: moto in-process (nothing leaves the machine). Set an endpoint to use LocalStack.
# MUSICPODS_AWS_ENDPOINT_URL=http://localhost:4566
MUSICPODS_AWS_REGION=eu-west-1
MUSICPODS_LAKE_BUCKET=musicpods-lake
MUSICPODS_FIREHOSE_STREAM=musicpods-listen-events
# 0 = replay as fast as possible; 60 = one hour of listening per minute.
MUSICPODS_REPLAY_SPEEDUP=0

# ---------------------------------------------------------------- batch, quality, logs
MUSICPODS_SESSION_GAP_MINUTES=30
MUSICPODS_DQ_FAIL_ON_ERROR=true
MUSICPODS_SNAPSHOT_RETENTION_DAYS=7
MUSICPODS_LOG_LEVEL=INFO
# text | json
MUSICPODS_LOG_FORMAT=text
DBT_TARGET=dev
